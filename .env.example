# ===== Backend =====
# Режим AI: MOCK (заглушка) или REAL (AI Core от ML-участника)
AI_MODE=MOCK

# Путь к SQLite базе внутри контейнера
DATABASE_PATH=/data/app.db

# Порт backend
PORT=8000

# Выдача всех заявок через GET /api/leads (содержит персональные данные).
# Только для локальной разработки/тестов: 1 = включено, иначе endpoint -> 404.
EXPOSE_LEADS=0

# ===== AI Core (REAL mode, настраивает ML-участник) =====
# Каталог с базой знаний (knowledge-base.zip распаковывается сюда)
DATA_DIR=./data
# API-ключ и endpoint модели Qwen — НЕ коммитить реальные значения
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
