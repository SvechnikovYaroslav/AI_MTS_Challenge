# ===== Backend =====
# Режим AI: MOCK (заглушка) или REAL (AI Core)
AI_MODE=MOCK

# Путь к SQLite базе внутри контейнера
DATABASE_PATH=/data/app.db

# Порт backend
PORT=8000

# Выдача всех заявок через GET /api/leads (содержит персональные данные).
# Только для локальной разработки/тестов: 1 = включено, иначе endpoint -> 404.
EXPOSE_LEADS=0

# ===== AI Core (REAL mode) =====
# Каталог с базой знаний (knowledge-base.zip / распакованный Knowledge-base/)
DATA_DIR=./data
# OpenAI-совместимый endpoint модели (прокси организаторов).
# Поддерживаемые имена: LLM_*, QWEN_*, OPENAI_*, GEN_MODEL — значения не коммитить.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Опционально: TOP_K (1-30, по умолч. 5), MAX_TOKENS, TEMPERATURE,
# MAX_WORKERS (1-8), LLM_TIMEOUT (сек), LLM_RETRIES, KB_CHUNK_CHARS
